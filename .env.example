# انسخ الملف ده باسم .env وعدّله

# كلمة سر دخول اللوحة (لو سبتها فاضية هيبقى الافتراضي admin123 — غيّرها من اللوحة)
ADMIN_PASSWORD=

# سيكريت عشوائي للجلسات — لازم يكون قوي (استخدم https://randomkey.io)
SESSION_SECRET=

# اختياري: توكن بوت هيتضاف تلقائياً كأول بوت أول ما تشغل البرنامج
BOT_TOKEN=

# رابط اللوحة:
#   محلي: http://localhost:3000
#   Railway: https://your-app.up.railway.app (عدّله من متغيرات البيئة)
BASE_URL=http://localhost:3000

# البورت — Railway بيحطه تلقائي في متغير PORT
PORT=3000
