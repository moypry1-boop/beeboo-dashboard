<%- include('partials/head', { title: 'اللوحة السرية' }) %>
<style>
  body { background: #0a0a0f; }
  .sec-nav { display:flex; align-items:center; justify-content:space-between; padding:12px 20px; background:rgba(0,0,0,.5); border-bottom:1px solid rgba(255,255,255,.06); }
  .sec-nav .brand { color:#ef4444; font-weight:800; font-size:14px; letter-spacing:2px; }
  .sec-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; padding:24px; max-width:1100px; margin:0 auto; }
  @media(max-width:740px){ .sec-grid{grid-template-columns:1fr} }

  .sec-card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:14px; padding:22px; }
  .sec-card h3 { margin-bottom:14px; font-size:16px; }
  .sec-card .hint { font-size:12px; color:rgba(255,255,255,.4); margin-bottom:10px; }

  /* مستمع */
  .listener-visual { background:#000; border-radius:10px; padding:18px; min-height:200px; margin-bottom:14px; position:relative; overflow:hidden; }
  .listener-visual .ring { position:absolute; bottom:30px; left:50%; transform:translateX(-50%); width:180px; height:180px; border-radius:50%; background:radial-gradient(circle,rgba(239,68,68,.15) 0%,transparent 70%); }
  .listener-visual.active .ring { animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{transform:translateX(-50%) scale(1);opacity:.4} 50%{transform:translateX(-50%) scale(1.3);opacity:1} }
  .listener-visual .label { position:absolute; bottom:12px; left:0; right:0; text-align:center; font-size:12px; color:rgba(255,255,255,.5); }

  .speaker-cards { display:grid; grid-template-columns:repeat(auto-fill, minmax(120px,1fr)); gap:10px; margin-bottom:14px; }
  .sp-card { background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.06); border-radius:10px; padding:10px; text-align:center; transition:all .3s; }
  .sp-card.speaking { border-color:#ef4444; background:rgba(239,68,68,.08); box-shadow:0 0 12px rgba(239,68,68,.2); }
  .sp-card img { width:36px; height:36px; border-radius:50%; margin-bottom:6px; }
  .sp-card .name { font-size:11px; color:rgba(255,255,255,.7); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  .vol-row { display:flex; align-items:center; gap:10px; }
  .vol-row input[type=range] { flex:1; accent-color:#ef4444; }

  /* نطق */
  .tts-textarea { width:100%; min-height:80px; resize:vertical; background:rgba(0,0,0,.3); border:1px solid rgba(255,255,255,.1); border-radius:8px; padding:12px; color:#fff; font-size:14px; }
  .voice-select { display:flex; gap:8px; margin:10px 0; }
  .voice-btn { flex:1; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.03); color:rgba(255,255,255,.6); cursor:pointer; text-align:center; transition:all .2s; }
  .voice-btn.active { border-color:#ef4444; background:rgba(239,68,68,.12); color:#ef4444; }

  /* اختيار البوت */
  .bot-select-bar { display:flex; gap:10px; padding:14px 24px; max-width:1100px; margin:0 auto; align-items:center; flex-wrap:wrap; }
  .bot-select-bar select { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:8px; padding:8px 12px; color:#fff; font-size:13px; min-width:160px; }
  .bot-select-bar select option { background:#1a1a2e; color:#fff; }
  .bot-status-dot { width:8px; height:8px; border-radius:50%; display:inline-block; margin-inline-start:6px; }
  .bot-status-dot.on { background:#22c55e; }
  .bot-status-dot.off { background:#ef4444; }
  #btn-mic.active { border-color:#ef4444!important; background:rgba(239,68,68,.15)!important; color:#ef4444!important; animation:micPulse 1s ease-in-out infinite; }
  @keyframes micPulse { 0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.3)} 50%{box-shadow:0 0 0 12px rgba(239,68,68,0)} }

  /* أزرار الصوت */
  .voice-join-bar { display:flex; gap:8px; padding:12px 24px; max-width:1100px; margin:0 auto; align-items:center; flex-wrap:wrap; background:rgba(239,68,68,.04); border-bottom:1px solid rgba(239,68,68,.12); }
  .voice-join-bar select { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:8px; padding:8px 12px; color:#fff; font-size:13px; min-width:180px; }
  .voice-join-bar select option { background:#1a1a2e; color:#fff; }
  .voice-join-bar .btn { min-width:120px; }
  .voice-status { font-size:12px; max-height:200px; overflow-y:auto; margin-top:6px; width:100%; white-space:pre-line; }
</style>

<nav class="sec-nav">
  <span class="brand">⚡ RED BULL</span>
  <div>
    <button class="btn btn-sm btn-outline" id="btn-lock" style="margin-inline-end:8px">🔒 قفل</button>
  </div>
</nav>

<!-- شريط اختيار البوت والروم -->
<div class="bot-select-bar" id="bot-select-bar">
  <span style="font-size:13px;color:rgba(255,255,255,.5)">🤖 البوت:</span>
  <select id="sel-bot"></select>
  <span style="font-size:13px;color:rgba(255,255,255,.5)">🏠 الروم:</span>
  <select id="sel-guild"></select>
  <span id="sel-status" style="font-size:12px"></span>
</div>

<!-- شريط الدخول للروم الصوتية -->
<div class="voice-join-bar" id="voice-join-bar">
  <span style="font-size:13px;color:rgba(255,255,255,.5)">🔊 الروم الصوتية:</span>
  <select id="sel-voice"></select>
  <button class="btn btn-success btn-sm" id="btn-join-one">🤖 دخول البوت هنا</button>
  <button class="btn btn-primary btn-sm" id="btn-join-all">🔥 دخول كل البوتات هنا</button>
  <button class="btn btn-danger btn-sm" id="btn-leave-one">🚪 خروج البوت</button>
  <div class="voice-status" id="voice-status"></div>
</div>

<div class="sec-grid">
  <!-- خريطة الصوت — كل بوت في رومه -->
  <div class="sec-card" style="grid-column:1/-1">
    <h3>🗺️ خريطة الصوت — كل بوت في رومه</h3>
    <p class="hint">حدد لكل بوت الروم الصوتية اللي يقعد فيها — يرجع تلقائي لو حد طلعه</p>
    <div id="voice-map-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-bottom:12px"></div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-success" id="btn-voice-map-save">💾 حفظ الخريطة</button>
      <button class="btn btn-primary" id="btn-voice-map-join">🚀 دخول الكل من الخريطة</button>
    </div>
    <div id="voice-map-status" style="margin-top:8px;font-size:12px"></div>
  </div>

  <!-- الاستماع -->
  <div class="sec-card">
    <h3>👂 الاستماع المباشر</h3>
    <p class="hint">اسمع اللي بيتقال في الروم بالوقت الحقيقي</p>

    <div class="listener-visual" id="lv">
      <div class="ring"></div>
      <div class="label" id="lv-label">اضغط "اتصل" للبدء</div>
    </div>

    <div class="speaker-cards" id="speakers"></div>

    <div class="vol-row mb14">
      <span style="font-size:13px">🔊</span>
      <input type="range" id="master-vol" min="0" max="200" value="80">
      <strong id="vol-num" style="font-size:13px;min-width:36px">80%</strong>
      <button class="btn btn-sm btn-outline" id="btn-mute">🔇</button>
    </div>

    <div style="display:flex;gap:8px">
      <button class="btn btn-success btn-block" id="btn-listen">📡 اتصل</button>
      <button class="btn btn-danger btn-block hidden" id="btn-disconnect">⏹️ قطع</button>
    </div>

    <!-- المايك -->
    <div style="margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08)">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <button class="btn" id="btn-mic" style="flex:1;padding:14px;border-radius:12px;border:2px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:rgba(255,255,255,.5);font-size:15px;transition:all .3s">
          🎙️ اضغط للتحدث
        </button>
      </div>
      <div id="mic-status" style="font-size:12px;color:rgba(255,255,255,.4);text-align:center"></div>
      <!-- مؤشر الصوت -->
      <div style="margin-top:8px;height:4px;background:rgba(255,255,255,.06);border-radius:2px;overflow:hidden">
        <div id="mic-level-bar" style="height:100%;width:0%;background:#ef4444;transition:width .1s;border-radius:2px"></div>
      </div>
    </div>
  </div>

  <!-- النطق -->
  <div class="sec-card">
    <h3>🗣️ النطق بالصوت</h3>
    <p class="hint">اكتب كلام والبوت ينطقه في الروم الصوتية</p>

    <select id="tts-voice" class="mb12">
      <option value="female">👩 صوت أنثى (سلمى)</option>
      <option value="male">👨 صوت ذكر (شكير)</option>
    </select>

    <textarea class="tts-textarea mb12" id="tts-text" placeholder="اكتب اللي عايز البوت يقوله..." maxlength="500" dir="auto"></textarea>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <small class="muted" id="tts-count">0/500</small>
      <small class="muted" id="tts-status"></small>
    </div>
    <button class="btn btn-primary btn-block" id="btn-say">🗣️ نطق</button>
  </div>
</div>

<script>
(function(){
  // === المتغيرات الأساسية ===
  let ws = null;
  const audioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 48000 });
  const speakers = new Map();
  const masterGain = audioCtx.createGain();
  masterGain.connect(audioCtx.destination);

  const lv = document.getElementById('lv');
  const lvLabel = document.getElementById('lv-label');
  const speakersEl = document.getElementById('speakers');
  const selBot = document.getElementById('sel-bot');
  const selGuild = document.getElementById('sel-guild');
  const selStatus = document.getElementById('sel-status');
  const selVoice = document.getElementById('sel-voice');
  const voiceStatus = document.getElementById('voice-status');

  // كل البوتات اللي جيناها من الـ API
  let allBots = [];
  let selectedBotId = null, selectedGuildId = null;

  // === تحميل البوتات ===
  async function loadBots() {
    try {
      const d = await fetch('/api/secret/bots').then(r => r.json());
      allBots = d.bots || [];
      if (!allBots.length) { selStatus.textContent = '❌ مفيش بوتات متصلة'; return; }

      // ملء قائمة البوتات
      selBot.innerHTML = '';
      allBots.forEach(b => {
        const opt = document.createElement('option');
        opt.value = b.id;
        opt.textContent = (b.online ? '🟢 ' : '🔴 ') + b.label;
        selBot.appendChild(opt);
      });

      // نحدد البوت المختار: URL > localStorage > أول بوت
      const urlBot = new URLSearchParams(location.search).get('botId');
      const savedBot = localStorage.getItem('secretBot');
      const initBot = urlBot || savedBot || allBots[0]?.id;
      if (initBot && allBots.find(b => b.id === initBot)) {
        selBot.value = initBot;
      }

      onBotChange();
    } catch { selStatus.textContent = '❌ فشل جلب البوتات'; }
  }

  function onBotChange() {
    selectedBotId = selBot.value;
    localStorage.setItem('secretBot', selectedBotId);

    const bot = allBots.find(b => b.id === selectedBotId);
    if (!bot || !bot.guilds?.length) {
      selGuild.innerHTML = '<option value="">— مفيش سيرفرات —</option>';
      selectedGuildId = null;
      selStatus.textContent = bot ? '⚠️ البوت مش في أي سيرفر' : '';
      return;
    }

    // ملء قائمة السيرفرات
    selGuild.innerHTML = '';
    bot.guilds.forEach(g => {
      const opt = document.createElement('option');
      opt.value = g.id;
      opt.textContent = g.voiceChannel ? '🔊 ' + g.name + ' (' + g.voiceChannel.name + ')' : '💬 ' + g.name;
      selGuild.appendChild(opt);
    });

    // نحدد السيرفر المختار
    const urlGuild = new URLSearchParams(location.search).get('guildId');
    const savedGuild = localStorage.getItem('secretGuild');
    const initGuild = urlGuild || savedGuild || bot.guilds[0]?.id;
    if (initGuild && bot.guilds.find(g => g.id === initGuild)) {
      selGuild.value = initGuild;
    }

    onGuildChange();
  }

  function onGuildChange() {
    selectedGuildId = selGuild.value;
    localStorage.setItem('secretGuild', selectedGuildId);

    const bot = allBots.find(b => b.id === selectedBotId);
    const guild = bot?.guilds?.find(g => g.id === selectedGuildId);

    // ملء قائمة الرومات الصوتية
    selVoice.innerHTML = '<option value="">— اختار روم صوتية —</option>';
    if (guild?.voiceChannels?.length) {
      guild.voiceChannels.forEach(vc => {
        const opt = document.createElement('option');
        opt.value = vc.id;
        opt.textContent = '🔊 ' + vc.name + (vc.members > 0 ? ' (' + vc.members + ')' : '');
        selVoice.appendChild(opt);
      });
    }

    if (!guild?.voiceChannel) {
      selStatus.textContent = '⚠️ البوت مش في روم صوتية';
    } else {
      selStatus.textContent = '✅ ' + guild.voiceChannel.name;
      // اختار الروم الحالي تلقائي
      if (guild.voiceChannel.id) selVoice.value = guild.voiceChannel.id;
    }
  }

  selBot.addEventListener('change', onBotChange);
  selGuild.addEventListener('change', onGuildChange);

  // أول تحميل
  loadBots();

  // === أزرار الدخول/الخروج من الروم الصوتية ===
  document.getElementById('btn-join-one').addEventListener('click', async () => {
    const channelId = selVoice.value;
    if (!selectedBotId || !selectedGuildId || !channelId) {
      voiceStatus.textContent = '❌ اختار بوت وسيرفر وروم صوتية الأول';
      return;
    }
    const btn = document.getElementById('btn-join-one');
    btn.disabled = true; btn.textContent = '⏳...';
    voiceStatus.textContent = '📡 جاري الدخول...';
    try {
      const d = await fetch('/api/secret/join-voice', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ botId: selectedBotId, guildId: selectedGuildId, channelId })
      }).then(r => r.json());
      voiceStatus.textContent = d.ok ? '✅ دخل البوت في الروم!' : '❌ ' + (d.error || 'خطأ');
    } catch { voiceStatus.textContent = '❌ فشل الاتصال'; }
    btn.disabled = false; btn.textContent = '🤖 دخول البوت هنا';
    if (voiceStatus.textContent.includes('✅')) loadBots(); // نحدّث الحالة
  });

  document.getElementById('btn-join-all').addEventListener('click', async () => {
    const channelId = selVoice.value;
    if (!selectedGuildId || !channelId) {
      voiceStatus.textContent = '❌ اختار سيرفر وروم صوتية الأول';
      return;
    }
    const btn = document.getElementById('btn-join-all');
    btn.disabled = true; btn.textContent = '⏳...';
    voiceStatus.textContent = '📡 جاري دخول كل البوتات...';
    try {
      const d = await fetch('/api/secret/join-voice-all', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guildId: selectedGuildId, channelId })
      }).then(r => r.json());
      if (d.ok && d.results) {
        const ok = d.results.filter(r => r.ok).length;
        const fail = d.results.filter(r => !r.ok).length;
        voiceStatus.textContent = `✅ نجح ${ok} | ❌ فشل ${fail}\n` +
          d.results.map(r => `${r.ok ? '✅' : '❌'} ${r.bot}${r.error ? ' — ' + r.error : ''}`).join('\n');
      } else {
        voiceStatus.textContent = '❌ ' + (d.error || 'خطأ');
      }
    } catch { voiceStatus.textContent = '❌ فشل الاتصال'; }
    btn.disabled = false; btn.textContent = '🔥 دخول كل البوتات هنا';
    if (voiceStatus.textContent.includes('✅')) loadBots();
  });

  document.getElementById('btn-leave-one').addEventListener('click', async () => {
    if (!selectedBotId || !selectedGuildId) {
      voiceStatus.textContent = '❌ اختار بوت وسيرفر الأول';
      return;
    }
    const btn = document.getElementById('btn-leave-one');
    btn.disabled = true; btn.textContent = '⏳...';
    try {
      const d = await fetch('/api/secret/leave-voice', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ botId: selectedBotId, guildId: selectedGuildId })
      }).then(r => r.json());
      voiceStatus.textContent = d.ok ? '✅ طلع البوت من الروم!' : '❌ ' + (d.error || 'خطأ');
    } catch { voiceStatus.textContent = '❌ فشل الاتصال'; }
    btn.disabled = false; btn.textContent = '🚪 خروج البوت';
    if (voiceStatus.textContent.includes('✅')) loadBots();
  });

  // === الاستماع ===
  let wsId = 0; // عشان نعرف أي WS هو الحالي

  function startListening() {
    // تفعيل AudioContext (المتصفح بيعمله suspend لحد ما المستخدم يتفاعل)
    if (audioCtx.state === 'suspended') audioCtx.resume();

    if (!selectedBotId || !selectedGuildId) { lvLabel.textContent = '❌ اختار بوت وروم الأول'; return; }
    lvLabel.textContent = '📡 جاري الاتصال...';

    const myWsId = ++wsId; // ID فريد لكل اتصال

    const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    ws = new WebSocket(`${wsProto}//${location.host}/ws/listen?botId=${selectedBotId}&guildId=${selectedGuildId}`);
    ws.binaryType = 'arraybuffer';

    // مخزن الصوت الجديد لكل جلسة استماع
    resetAudioQueue();
    startAudioTick();

    ws.onopen = () => {
      if (wsId !== myWsId) return; // اتصال قديم، تجاهل
      document.getElementById('btn-listen').classList.add('hidden');
      document.getElementById('btn-disconnect').classList.remove('hidden');
    };

    ws.onmessage = (evt) => {
      if (wsId !== myWsId) return; // اتصال قديم، تجاهل
      if (typeof evt.data === 'string') {
        const msg = JSON.parse(evt.data);
        if (msg.type === 'error') { lvLabel.textContent = '❌ ' + msg.message; return; }
        if (msg.type === 'channel') {
          lvLabel.textContent = '🎙️ ' + msg.name + ' — جاري الاستماع';
          lv.classList.add('active');
          updateSpeakers(msg.members || []);
        }
        if (msg.type === 'join') addSpeaker(msg.member);
        if (msg.type === 'leave') removeSpeaker(msg.userId);
        if (msg.type === 'mic_started') { console.log('[MIC] server started mic'); }
        if (msg.type === 'mic_stopped') { console.log('[MIC] server stopped mic'); }
      } else {
        playAudioFrame(evt.data);
      }
    };

    ws.onerror = () => { if (wsId !== myWsId) return; lvLabel.textContent = '❌ خطأ في الاتصال'; };
    ws.onclose = () => {
      if (wsId !== myWsId) return; // اتصال قديم اتقفل — متقفلش المايك!
      lvLabel.textContent = '🔴 تم قطع الاتصال';
      lv.classList.remove('active');
      document.getElementById('btn-listen').classList.remove('hidden');
      document.getElementById('btn-disconnect').classList.add('hidden');
      stopMic();
    };
  }

  function stopListening() {
    wsId++; // نلغي أي اتصال قديم
    if (ws) { ws.close(); ws = null; }
    resetAudioQueue(); // ننضّف مخزن الصوت
    speakers.clear();
    speakersEl.innerHTML = '';
    lvLabel.textContent = 'تم القطع';
    lv.classList.remove('active');
  }

  document.getElementById('btn-listen').addEventListener('click', startListening);
  document.getElementById('btn-disconnect').addEventListener('click', stopListening);

  // فوليوم
  document.getElementById('master-vol').addEventListener('input', (e) => {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const v = Number(e.target.value);
    masterGain.gain.value = v / 100;
    document.getElementById('vol-num').textContent = v + '%';
  });
  document.getElementById('btn-mute').addEventListener('click', () => {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    masterGain.gain.value = masterGain.gain.value > 0 ? 0 : 0.8;
  });

  function updateSpeakers(list) {
    speakersEl.innerHTML = '';
    list.forEach(s => addSpeaker(s));
  }

  function addSpeaker(s) {
    if (speakers.has(s.id)) return;
    speakers.set(s.id, { ...s, speaking: false });
    const div = document.createElement('div');
    div.className = 'sp-card';
    div.id = 'sp-' + s.id;
    div.innerHTML = `<img src="${s.avatar || ''}" onerror="this.style.display='none'" alt=""><div class="name">${esc(s.name)}</div>`;
    speakersEl.appendChild(div);
  }

  function removeSpeaker(userId) {
    speakers.delete(userId);
    const el = document.getElementById('sp-' + userId);
    if (el) el.remove();
  }

  // === Jitter buffer: نخزن الصوت ونشغّله بساعة مستمرة — لو قطعة وصلت متأخرة
  // مش هيحصل فراغ لأن قدامنا مخزن. ده اللي بيخلي الصوت ما يقطعش.
  let audioQueue = [];
  let audioNextTime = null;
  let audioTick = null;

  function resetAudioQueue() {
    audioQueue = [];
    audioNextTime = null;
    if (audioTick) { clearInterval(audioTick); audioTick = null; }
  }

  function startAudioTick() {
    if (audioTick) clearInterval(audioTick);
    audioNextTime = null;
    audioTick = setInterval(scheduleAudio, 50);
  }

  function scheduleAudio() {
    if (!audioQueue.length) { audioNextTime = null; return; }
    const ctxNow = audioCtx.currentTime;
    if (audioNextTime === null || audioNextTime < ctxNow - 0.3) {
      // كان واقف/متأخر — نبني مخزن صغير قبل ما نكمل
      audioNextTime = ctxNow + 0.15;
    }
    // نحدد مصادر حتى 350ms قدام — فتأخير الشبكة مش هيسبب قطع
    while (audioQueue.length && audioNextTime < ctxNow + 0.35) {
      const buf = audioQueue.shift();
      const src = audioCtx.createBufferSource();
      src.buffer = buf;
      src.connect(masterGain);
      src.start(audioNextTime);
      audioNextTime += buf.duration;
    }
    if (audioQueue.length > 80) audioQueue.splice(0, audioQueue.length - 80); // حد أمان
  }

  function playAudioFrame(buffer) {
    if (masterGain.gain.value <= 0) return;
    // تحويل Blob → ArrayBuffer لو لازم
    const ab = buffer instanceof ArrayBuffer ? buffer : buffer.buffer;
    const view = new DataView(ab);
    const userId = view.getUint32(0, true);
    const pcmBytes = new Uint8Array(ab, 4);
    const sampleCount = Math.floor(pcmBytes.length / 4); // 16bit * 2ch = 4 bytes per sample
    const left = new Float32Array(sampleCount);
    const right = new Float32Array(sampleCount);
    const pcmView = new DataView(pcmBytes.buffer, pcmBytes.byteOffset, pcmBytes.byteLength);
    for (let i = 0; i < sampleCount; i++) {
      left[i] = pcmView.getInt16(i * 4, true) / 32768;
      right[i] = pcmView.getInt16(i * 4 + 2, true) / 32768;
    }
    const buf = audioCtx.createBuffer(2, sampleCount, 48000);
    buf.getChannelData(0).set(left);
    buf.getChannelData(1).set(right);

    // نخزّن في المخزن بدل التشغيل الفوري
    audioQueue.push(buf);

    const el = document.getElementById('sp-' + userId);
    if (el) {
      el.classList.add('speaking');
      clearTimeout(el._t);
      el._t = setTimeout(() => el.classList.remove('speaking'), 500);
    }
  }

  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  // === النطق ===
  const ttsText = document.getElementById('tts-text');
  const ttsCount = document.getElementById('tts-count');
  ttsText.addEventListener('input', () => { ttsCount.textContent = ttsText.value.length + '/500'; });

  document.getElementById('btn-say').addEventListener('click', async () => {
    const text = ttsText.value.trim();
    if (!text) return;
    if (!selectedBotId || !selectedGuildId) return document.getElementById('tts-status').textContent = '❌ اختار بوت وروم الأول';

    const btn = document.getElementById('btn-say');
    btn.disabled = true; btn.textContent = '⏳ جاري النطق...';
    document.getElementById('tts-status').textContent = '';
    try {
      const d = await fetch('/api/secret/say', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, voice: document.getElementById('tts-voice').value, botId: selectedBotId, guildId: selectedGuildId })
      }).then(r => r.json());
      if (d.ok) { document.getElementById('tts-status').textContent = '✅ تم النطق'; ttsText.value = ''; ttsCount.textContent = '0/500'; }
      else document.getElementById('tts-status').textContent = '❌ ' + (d.error || 'خطأ');
    } catch { document.getElementById('tts-status').textContent = '❌ فشل الاتصال'; }
    btn.disabled = false; btn.textContent = '🗣️ نطق';
  });

  // === قفل ===
  document.getElementById('btn-lock').addEventListener('click', async () => {
    await fetch('/api/secret/lock', { method: 'POST' });
    location.href = '/';
  });

  // === المايك: التحدث في الروم ===
  const btnMic = document.getElementById('btn-mic');
  const micStatus = document.getElementById('mic-status');
  const micLevelBar = document.getElementById('mic-level-bar');
  let micStream = null;
  let micProc = null;
  let micAudioCtx = null;
  let micActive = false;
  let micLevelInterval = null;

  function micLog(msg) { console.log('[MIC]', msg); }
  function micShowStatus(text, color) {
    micStatus.textContent = text;
    micStatus.style.color = color || '';
    micLog(text);
  }

  // تأكد إن الـ WebSocket شغال — لو مش شغال يتصل
  async function ensureWs() {
    if (ws && ws.readyState === WebSocket.OPEN) return true;
    if (!selectedBotId || !selectedGuildId) return false;
    micShowStatus('📡 جاري الاتصال بالسيرفر...', '#f59e0b');
    // لو في WS قديم اقفله
    if (ws) { try { ws.close(); } catch {} ws = null; }
    // اتصل
    startListening();
    // استنى لحد ما يفتح (حد أقصى 5 ثواني)
    for (let i = 0; i < 50; i++) {
      if (ws && ws.readyState === WebSocket.OPEN) return true;
      await new Promise(r => setTimeout(r, 100));
    }
    return false;
  }

  btnMic.onclick = async function() {
    micLog('btn-mic clicked, micActive=' + micActive);
    if (micActive) { stopMic(); return; }

    // فحص if mediaDevices موجود
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      micShowStatus('❌ المايك مش متاح — استخدم HTTPS أو localhost', '#ef4444');
      return;
    }

    // تأكد الـ WS شغال
    const ok = await ensureWs();
    if (!ok) {
      micShowStatus('❌ فشل الاتصال بالسيرفر', '#ef4444');
      return;
    }

    try {
      micShowStatus('⏳ جاري فتح المايك...', '#f59e0b');

      // فتح المايك
      micStream = await navigator.mediaDevices.getUserMedia({
        audio: {
          echoCancellation: true,
          noiseSuppression: true,
          autoGainControl: true,
        }
      });
      micLog('getUserMedia OK, tracks=' + micStream.getTracks().length);

      // AudioContext
      micAudioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 48000 });
      if (micAudioCtx.state === 'suspended') await micAudioCtx.resume();

      const source = micAudioCtx.createMediaStreamSource(micStream);

      // Analyser لمؤشر الصوت
      const analyser = micAudioCtx.createAnalyser();
      analyser.fftSize = 256;
      source.connect(analyser);

      // ScriptProcessor: 960 عينة = 20ms عند 48kHz
      micProc = micAudioCtx.createScriptProcessor(960, 2, 2);

      micProc.onaudioprocess = function(e) {
        if (!ws || ws.readyState !== WebSocket.OPEN || !micActive) return;
        var left = e.inputBuffer.getChannelData(0);
        var right = e.inputBuffer.getChannelData(1);
        var len = left.length;

        // Float32 → Int16 PCM stereo interleaved
        var buf = new ArrayBuffer(len * 4);
        var dv = new DataView(buf);
        for (var i = 0; i < len; i++) {
          var l = left[i] < -1 ? -32768 : left[i] > 1 ? 32767 : (left[i] * 32767 + 0.5) | 0;
          var r = right[i] < -1 ? -32768 : right[i] > 1 ? 32767 : (right[i] * 32767 + 0.5) | 0;
          dv.setInt16(i * 4, l, true);
          dv.setInt16(i * 4 + 2, r, true);
        }
        try { ws.send(new Uint8Array(buf)); } catch(ex) { micLog('send err: ' + ex.message); }
      };

      // وصل: source → micProc → destination (لازم يكون موصول عشان onaudioprocess يشتغل)
      source.connect(micProc);
      micProc.connect(micAudioCtx.destination);
      micLog('audio graph connected');

      // مؤشر مستوى الصوت
      var dataArray = new Uint8Array(analyser.frequencyBinCount);
      micLevelInterval = setInterval(function() {
        analyser.getByteFrequencyData(dataArray);
        var sum = 0;
        for (var i = 0; i < dataArray.length; i++) sum += dataArray[i];
        var avg = sum / dataArray.length;
        var pct = Math.min(100, avg * 1.5);
        micLevelBar.style.width = pct + '%';
        micLevelBar.style.background = pct > 80 ? '#ef4444' : pct > 30 ? '#f59e0b' : '#22c55e';
      }, 100);

      // نبّه السيرفر
      ws.send(JSON.stringify({ type: 'mic_start' }));
      micLog('sent mic_start');

      micActive = true;
      btnMic.classList.add('active');
      btnMic.innerHTML = '🎙️ جاري التحدث... (اضغط للإيقاف)';
      micShowStatus('🔴 المايك مفتوح — اتكلم!', '#ef4444');

    } catch (err) {
      micLog('ERROR: ' + err.name + ': ' + err.message);
      if (err.name === 'NotAllowedError') {
        micShowStatus('❌ رفض إذن المايك — افتح الإعدادات وسمّح', '#ef4444');
      } else if (err.name === 'NotFoundError') {
        micShowStatus('❌ مفيش مايك متصل بالجهاز', '#ef4444');
      } else {
        micShowStatus('❌ ' + err.name + ': ' + err.message, '#ef4444');
      }
      stopMic();
    }
  };

  function stopMic() {
    micLog('stopMic called');
    micActive = false;
    btnMic.classList.remove('active');
    btnMic.innerHTML = '🎙️ اضغط للتحدث';
    micStatus.textContent = '';
    micStatus.style.color = '';
    micLevelBar.style.width = '0%';

    if (micLevelInterval) { clearInterval(micLevelInterval); micLevelInterval = null; }
    if (micProc) { try { micProc.disconnect(); } catch {} micProc = null; }
    if (micAudioCtx) { micAudioCtx.close().catch(() => {}); micAudioCtx = null; }
    if (micStream) { micStream.getTracks().forEach(function(t) { t.stop(); }); micStream = null; }

    if (ws && ws.readyState === 1) {
      try { ws.send(JSON.stringify({ type: 'mic_stop' })); } catch {}
    }
  }

  // === خريطة الصوت ===
  const voiceMapList = document.getElementById('voice-map-list');
  const voiceMapStatus = document.getElementById('voice-map-status');

  async function loadVoiceMap() {
    // نجيب كل البوتات والروم الصوتية
    const botsRes = await fetch('/api/secret/bots').then(r => r.json());
    const mapRes = await fetch('/api/secret/voice-map').then(r => r.json());
    const bots = botsRes.bots || [];
    const voiceMap = mapRes.map || {};

    voiceMapList.innerHTML = '';
    for (const bot of bots) {
      // نجمع كل الرومات الصوتية من كل السيرفرات
      const allChannels = [];
      for (const g of (bot.guilds || [])) {
        for (const vc of (g.voiceChannels || [])) {
          allChannels.push({ id: vc.id, name: vc.name + ' (' + g.name + ')', guild: g.name });
        }
      }

      const div = document.createElement('div');
      div.style.cssText = 'background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:12px';
      div.innerHTML = `
        <div style="font-size:13px;font-weight:600;margin-bottom:6px">${bot.online ? '🟢' : '🔴'} ${esc(bot.label)}</div>
        <select data-bot-id="${bot.id}" style="width:100%;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1);border-radius:6px;padding:6px;color:#fff;font-size:12px">
          <option value="">— بدون روم —</option>
          ${allChannels.map(ch => `<option value="${ch.id}" ${voiceMap[bot.id] === ch.id ? 'selected' : ''}>🔊 ${esc(ch.name)}</option>`).join('')}
        </select>
      `;
      voiceMapList.appendChild(div);
    }
  }

  document.getElementById('btn-voice-map-save').addEventListener('click', async () => {
    const selects = voiceMapList.querySelectorAll('select[data-bot-id]');
    const map = {};
    selects.forEach(sel => {
      if (sel.value) map[sel.getAttribute('data-bot-id')] = sel.value;
    });
    voiceMapStatus.textContent = '⏳ جاري الحفظ...';
    const d = await fetch('/api/secret/voice-map', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ map })
    }).then(r => r.json());
    voiceMapStatus.textContent = d.ok ? '✅ اتحفظت الخريطة!' : '❌ ' + (d.error || 'خطأ');
  });

  document.getElementById('btn-voice-map-join').addEventListener('click', async () => {
    voiceMapStatus.textContent = '📡 جاري دخول كل البوتات...';
    const d = await fetch('/api/secret/join-voice-from-map', { method: 'POST', headers: { 'Content-Type': 'application/json' } }).then(r => r.json());
    if (d.ok && d.results) {
      const ok = d.results.filter(r => r.ok).length;
      const fail = d.results.filter(r => !r.ok).length;
      voiceMapStatus.innerHTML = `✅ دخل ${ok} | ❌ فشل ${fail}<br>` +
        d.results.map(r => `${r.ok ? '✅' : '❌'} ${r.bot}${r.channel ? ' → ' + r.channel : ''}${r.error ? ' — ' + r.error : ''}`).join('<br>');
    } else {
      voiceMapStatus.textContent = '❌ ' + (d.error || 'خطأ');
    }
  });

  // تحميل الخريطة أول ما الصفحة تفتح
  setTimeout(loadVoiceMap, 500);
})();
</script>
</body>
</html>
